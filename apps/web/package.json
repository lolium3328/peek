{
  "name": "@peek/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "dev": "bun run build && bun --hot server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "bun --hot server/index.ts",
    "start": "bun server/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "lucide": "^1.16.0"
  }
}
